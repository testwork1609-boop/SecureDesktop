<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" />
  
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SecureDesktop</RootNamespace>
    <AssemblyName>SecureDesktop</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
  </PropertyGroup>
  
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
  </PropertyGroup>
  
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Costura.Fody" Version="5.7.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Fody" Version="6.8.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Models\User.cs" />
    <Compile Include="Models\Pattern.cs" />
    <Compile Include="Models\Session.cs" />
    <Compile Include="Models\EventLog.cs" />
    <Compile Include="Database\DatabaseInitializer.cs" />
    <Compile Include="Database\Repositories\UserRepository.cs" />
    <Compile Include="Database\Repositories\SessionRepository.cs" />
    <Compile Include="Database\Repositories\PatternRepository.cs" />
    <Compile Include="Database\Repositories\EventLogRepository.cs" />
    <Compile Include="Services\PatternRecognitionService.cs" />
    <Compile Include="Services\ScreenLockService.cs" />
    <Compile Include="Services\BackupService.cs" />
    <Compile Include="Services\FileMonitorService.cs" />
    <Compile Include="Services\ConfigurationService.cs" />
    <Compile Include="Forms\LoginForm.cs" />
    <Compile Include="Forms\DashboardForm.cs" />
    <Compile Include="Forms\ScreenLockForm.cs" />
    <Compile Include="Forms\ConfigurationForm.cs" />
    <Compile Include="Forms\EventHistoryForm.cs" />
    <Compile Include="Utils\SecurityHelper.cs" />
    <Compile Include="Core\SecurityManager.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>